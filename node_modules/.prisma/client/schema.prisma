datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Movie {
  id             String          @id
  slug           String          @unique
  title          String
  type           String          @default("movie") // "movie" | "series"
  synopsis       String
  releaseYear    Int             @default(2024)
  duration       String
  rating         String          @default("8.5")
  genres         String // Comma-separated or JSON
  posterUrl      String
  backdropUrl    String
  trailerUrl     String?
  videoUrl       String?
  isFeatured     Boolean         @default(false)
  isTrending     Boolean         @default(false)
  isImax         Boolean         @default(false)
  director       String?
  cast           String? // JSON string
  episodes       Episode[]
  watchlistItems WatchlistItem[]
  watchProgress  WatchProgress[]
  createdAt      DateTime        @default(now())
}

model Episode {
  id            String  @id
  seriesId      String
  series        Movie   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  season        Int     @default(1)
  episodeNumber Int
  title         String
  synopsis      String
  duration      String
  videoUrl      String
  stillUrl      String?
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String?
  plan      String    @default("Ultra 4K CineVIP")
  profiles  Profile[]
  createdAt DateTime  @default(now())
}

model Profile {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatar    String
  isKids    Boolean         @default(false)
  watchlist WatchlistItem[]
  history   WatchProgress[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, movieId])
}

model WatchProgress {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId   String?
  currentTime Int      @default(0)
  duration    Int      @default(0)
  progress    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([profileId, movieId])
}
